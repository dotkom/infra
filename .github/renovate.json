{
	"$schema": "https://docs.renovatebot.com/renovate-schema.json",
	"configMigration": true,
	"extends": ["config:best-practices"],
	"semanticCommits": "disabled",
	"major": {
		"automerge": false
	},
	"minor": {
		"automerge": true
	},
	"patch": {
		"automerge": true
	},
	"schedule": ["* * * * 6"],
	"minimumReleaseAge": "14 days"
}
